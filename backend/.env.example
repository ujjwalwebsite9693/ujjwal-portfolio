# ================================
# SERVER
# ================================
PORT=5000
NODE_ENV=development

# ================================
# MONGODB ATLAS
# 1. Go to https://www.mongodb.com/cloud/atlas/register
# 2. Create a free (M0) cluster
# 3. Database Access -> add a user with a password
# 4. Network Access -> Add IP Address -> Allow Access From Anywhere (0.0.0.0/0)
# 5. Connect -> Drivers -> copy the connection string below
# ================================
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ujjwal-portfolio?retryWrites=true&w=majority

# ================================
# AUTH
# Generate a strong random string for JWT_SECRET, e.g. run:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ================================
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# First-run admin account (used only by utils/seed.js to create your admin login)
ADMIN_EMAIL=ujjwalcse07@gmail.com
ADMIN_PASSWORD=change_this_password_after_first_login

# ================================
# CORS
# Your deployed Vercel frontend URL (add both with and without trailing slash issues in mind)
# ================================
CLIENT_URL=http://localhost:5173

# ================================
# YOUTUBE DATA API v3 (optional, for auto-fetching your latest videos)
# 1. Go to https://console.cloud.google.com/
# 2. Create a project -> Enable "YouTube Data API v3"
# 3. Create Credentials -> API Key
# 4. Paste it below
# ================================
YOUTUBE_API_KEY=your_youtube_data_api_key_here
YOUTUBE_CHANNEL_HANDLE=@Ujjwalmehta1

# ================================
# CLOUDINARY (optional, for image uploads - projects/certificates/profile pics)
# Sign up free at https://cloudinary.com
# Dashboard shows these 3 values directly
# ================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
